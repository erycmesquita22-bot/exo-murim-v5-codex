+    if not ok:errors.append(label)
+func _initialize() -> void:
+    var fresh: Dictionary=Legacy.fresh()
+    check(Legacy.valid(fresh),"legacy_fresh")
+    check(Generator.TYPES.size()==7,"legacy_seven_types")
