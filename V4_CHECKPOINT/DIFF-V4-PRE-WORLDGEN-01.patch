+for entry in manifest['catalogs']:
+ d=entry['domain']; x=load(M/'data'/f'{d}.json'); domains[d]=x['records'];check(x['schema']=='exo.world_library.catalog.v1','bad_catalog:'+d);check(len(x['records'])==entry['count'],'bad_count:'+d)
