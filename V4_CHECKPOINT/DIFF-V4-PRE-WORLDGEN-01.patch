+ len(d['internal_streets'])>=2 and LineString([d['internal_streets'][0]['a'],d['internal_streets'][0]['b']]).intersects(LineString([d['internal_streets'][1]['a'],d['internal_streets'][1]['b']]))
+ for d in new_districts))
