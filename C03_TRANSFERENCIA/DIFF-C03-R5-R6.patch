+func _clear_encounters() -> void:
+ if core!=null and is_instance_valid(core.world):
+  for uid in encounter_actors.keys():
+   var enemy: Variant=encounter_actors[uid]
+   if is_instance_valid(enemy):
+    core.world.enemies.erase(enemy)
