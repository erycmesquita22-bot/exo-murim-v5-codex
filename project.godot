config_version=5

[application]
config/name="EXO-Murim V5"
config/use_custom_user_dir=true
config/custom_user_dir_name="EXO-Murim-V5"
run/main_scene="res://convergence/game.tscn"

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/size/window_width_override=1152
window/size/window_height_override=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035,0.05,0.08,1)

[exo_murim]
r4/fauna_enabled=true
r5/harmonized_creatures_enabled=true
r6/dungeon_encounters_enabled=true
r6/dungeon_atomic_rewards_enabled=true
r7/monuments_enabled=true
r7/institutional_interiors_enabled=true

exo_murim/r8/martial_enabled=true

[exo_murim/r9]
school_occupancy_enabled=true
martial_training_enabled=true

[exo_murim/r10]
humanoids_enabled=true

[exo_murim/terrain_forge]
enabled=true
foliage_density=1.0

[exo_murim/city_forge]
mode="authored_modular"

[exo_murim/crowd]
enable=true

[exo_murim/convergence4]
bestiary_tactics=true
authorial_skills=true
physical_interiors=true

[exo_murim/worldgen_v5]
replace_settlements=true

[editor]

import/use_multiple_threads=false
