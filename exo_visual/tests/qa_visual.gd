extends "res://validation_r3/support.gd"
const Spec=preload("res://exo_visual/spec.gd")
const Graphics=preload("res://graphics.gd")
func _initialize() -> void:call_deferred("run_visual")
func run_visual() -> void:
 await boot("user://exo_visual_test_save.json")
 check(w.exo_core.ready,"official_core_boot")
 check(w.exo_core.services.has_service("exo_visual"),"exo_visual_registered_in_official_core")
 check(w.exo_core.registry.modules.size()>=10,"preserve_nine_existing_modules")
 # UI preview frames must not advance the gameplay clock during this comparison.
 w.set_physics_process(false)
 w.encounters.set_physics_process(false)
 var snapshot: String=JSON.stringify(w.journey.data)
 var original_preset: int=w.graphics.level
 for i in range(5):
  check(w.graphics.select(i),"apply_preset_"+str(i))
  check(w.graphics.level==i,"read_preset_"+str(i))
  w.ui.exo.open("config")
  await frames(2)
  check(w.ui.exo.visible,"configuration_opens_for_preset_"+str(i))
  w.ui.resume()
 check(w.graphics.set_option("water_quality",3),"independent_water")
 check(w.graphics.level==5,"custom_preset_after_override")
 w.ui.exo.open("config")
 await frames(2)
 check(w.ui.exo.visible,"configuration_opens_custom_profile")
 w.ui.resume()
 check(w.graphics.set_option("grass_density",0),"decorative_grass_off")
 check(not w.graphics.set_option("water_quality",99) or w.graphics.get_option("water_quality")!=99,"invalid_option_normalized")
 check(not w.graphics.set_option("not_a_real_setting",1),"unknown_option_refused")
 check(w.graphics.get_option("water_quality")==int(w.graphics.values.water_quality),"water_option_active")
 check(not Spec.available("ssil") if not Spec.renderer_is_forward() else true,"forward_only_feature_gate")
 check(JSON.stringify(w.journey.data)==snapshot,"graphics_does_not_change_gameplay_save")
 var reloaded=Graphics.new(w,w.settings_path)
 check(reloaded.level==5 and reloaded.get_option("grass_density")==0,"settings_reopen")
 var invalid:=ConfigFile.new();invalid.load(w.settings_path);invalid.set_value("exo_visual","grass_density",9999)
 invalid.save(w.settings_path)
 var sanitized=Graphics.new(w,w.settings_path)
 check(sanitized.get_option("grass_density")==int(Spec.OPTIONS.grass_density.default),"invalid_setting_fallback")
 for path in ["res://exo_visual/shaders/water.gdshader","res://exo_visual/shaders/grass_wind.gdshader","res://exo_visual/shaders/terrain_pixel.gdshader","res://exo_visual/shaders/terrain_pixel_mips.gdshader","res://exo_visual/shaders/terrain_linear.gdshader"]:
  check(ResourceLoader.exists(path) and load(path) is Shader,"shader_resource_"+path.get_file())
 var before_regions: String=JSON.stringify(w.journey.data.get("convergence",{}))
 check(await w.change_region(78),"real_seed_city_region")
 if is_instance_valid(w.active_region):
  var water_nodes: Array=w.get_tree().get_nodes_in_group("exo_visual_water")
  var ground_nodes: Array=w.get_tree().get_nodes_in_group("exo_visual_terrain")
  check(ground_nodes.size()>0,"approved_ground_material_applied")
  check(water_nodes.size()>0 or w.active_region.data.rivers.is_empty(),"river_water_material_applied")
  var region_id: int=w.current_region
  w.graphics.select(4)
  var high: String=JSON.stringify(w.active_region.data.spec)
  w.graphics.select(0)
  check(w.current_region==region_id and JSON.stringify(w.active_region.data.spec)==high,"world_spec_unchanged_by_preset")
  check(w.active_region.data.validate().is_empty(),"procedural_region_still_valid")
 facts={"renderer":RenderingServer.get_current_rendering_method(),"engine":Engine.get_version_info().string,"presets":5,"original_preset":original_preset,"world_state_before":before_regions,"diagnostics":w.graphics.diagnostics()}
 await finish("exo_visual_01")
