extends "res://validation_r3/support.gd"
## Screenshot generated by the actual Godot viewport; never a conceptual render.
func _initialize() -> void:call_deferred("capture")
func capture() -> void:
 if DisplayServer.get_name()=="headless":
  print("VISUAL_PILOT_NOT_RUN: real viewport required")
  quit(2);return
 await boot("user://exo_visual_pilot_save.json")
 var rid: int=78
 if not await w.change_region(rid):
  print("VISUAL_PILOT_FAIL: no region ",rid)
  quit(1);return
 w.graphics.select(3)
 w.camera.size=44
 w.update_camera()
 await frames(90)
 await RenderingServer.frame_post_draw
 var image: Image=w.get_viewport().get_texture().get_image()
 var path: String="user://exo_visual_pilot_78_high.png"
 var err: int=image.save_png(path)
 var meta: Dictionary={"seed":101,"region":rid,"graphics_preset":3,"capture_path":path,"save_result":err,"camera_transform":str(w.camera.global_transform),"rendering_method":RenderingServer.get_current_rendering_method(),"engine":Engine.get_version_info().string}
 var out:=FileAccess.open("user://exo_visual_pilot_metadata.json",FileAccess.WRITE)
 if out!=null:out.store_string(JSON.stringify(meta,"  "))
 print("EXO_VISUAL_PILOT ",JSON.stringify(meta))
 w.audio_fx.shutdown();w.free();quit(int(err!=OK))
