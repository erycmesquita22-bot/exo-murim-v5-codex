{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "city_placement_schema",
  "type": "object",
  "required": [
    "region_id",
    "region_seed",
    "kind",
    "settlement_scale",
    "half_extent",
    "gates",
    "rivers",
    "monument_reservations"
  ],
  "properties": {
    "region_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 87
    },
    "gates": {
      "type": "array",
      "minItems": 1
    },
    "monument_reservations": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
