{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "district_schema",
  "type": "object",
  "required": [
    "id",
    "category",
    "footprint",
    "buildings",
    "internal_streets",
    "connectors"
  ],
  "properties": {
    "category": {
      "type": "string"
    },
    "buildings": {
      "type": "array",
      "minItems": 2
    },
    "internal_streets": {
      "type": "array",
      "minItems": 1
    },
    "allowed_scales": {
      "type": "array",
      "items": {
        "enum": [
          "village",
          "town",
          "city"
        ]
      }
    }
  },
  "additionalProperties": true
}
