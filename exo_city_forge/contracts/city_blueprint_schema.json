{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "city_blueprint_schema",
  "type": "object",
  "required": [
    "id",
    "shape",
    "sectors",
    "gates",
    "streets"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "sectors": {
      "type": "array",
      "minItems": 4
    },
    "streets": {
      "type": "array",
      "minItems": 2
    },
    "allowed_scales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "village",
          "town",
          "city"
        ]
      }
    },
    "shape": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
